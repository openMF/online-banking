# =============================================================================
# Self Service Plugin (Apache Fineract) connection
# https://github.com/openMF/selfservice-plugin
# =============================================================================

# Origin of the Fineract instance (no trailing slash)
SELF_SERVICE_BASE_URL=https://demo.mifos.community

# API path prefix before /v1/self  (no trailing slash)
# Typical Fineract Docker/Tomcat value:
SELF_SERVICE_ENDPOINT=/fineract-provider/api

# Optional API key (sent as X-API-Key). Leave empty if not used.
SELF_SERVICE_API_KEY=

# Fineract tenant identifier (header: Fineract-Platform-TenantId)
SELF_SERVICE_TENANT_ID=default

# -----------------------------------------------------------------------------
# Vite client-side mirrors (required for browser calls; same values as above)
# -----------------------------------------------------------------------------
VITE_SELF_SERVICE_BASE_URL=https://demo.mifos.community
VITE_SELF_SERVICE_ENDPOINT=/fineract-provider/api
VITE_SELF_SERVICE_API_KEY=
VITE_SELF_SERVICE_TENANT_ID=default
